# Makefile.pc - Portable Linux build for pipensx-video-downloader
# Requires: gcc/clang, libcurl-dev, pthreads (usually built-in)

CC      ?= cc
CFLAGS  := -std=c11 -Wall -Wextra -O2 -I. -I./core
LDFLAGS := -lcurl -lpthread
TARGET  := pipensx-video-downloader

CORE_SOURCES := $(wildcard core/*.c)
CORE_HEADERS := $(wildcard core/*.h)

OBJECTS := $(CORE_SOURCES:.c=.o)

.PHONY: all clean test

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

core/%.o: core/%.c $(CORE_HEADERS)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(TARGET) $(OBJECTS)
