# Makefile.switch - Empaquetado para Nintendo Switch
#
# Este Makefile gestiona el empaquetado del homebrew para SD card.
# Para compilar el .nro necesitas devkitPRO completo (devkitARM + libnx).
# Hasta entonces, puedes usar la estructura de SD card en sdcard/
#
# Requisitos:
# - devkitPro instalado (https://devkitpro.org) — opcional para sdcard
# - Uso: make sdcard (siempre funciona) o make switch (requiere devkitPRO)
#
# Uso:
#   make switch    - Compilar para Switch (requiere devkitPRO completo)
#   make sdcard    - Crear estructura de carpetas para SD card
#   make help      - Mostrar ayuda

ROOT := $(CURDIR)
DEVKITPRO ?= /opt/devkitpro
APP_NAME := pipensx-video-downloader

.PHONY: all switch sdcard help

all: switch

switch:
	@echo "=== Building for Nintendo Switch ==="
	@echo "Checking devkitPRO setup..."
	@if [[ ! -d "$(DEVKITPRO)/libnx" ]]; then \
		echo "ERROR: devkitPRO not properly installed."; \
		echo "Install: sudo pacman -S devkitARM devkitSwitch"; \
		echo "Or: apt install devkitpro-pacman && devkitpro-pacman -S devkitARM devkitSwitch"; \
		echo ""; \
		echo "The project can still be tested on Linux:"; \
		echo "  make -f Makefile.Linux"; \
		echo ""; \
		echo "SD card packaging structure is in sdcard/switch/$(APP_NAME)/"; \
		false; \
	fi
	./scripts/package_switch.sh all

sdcard:
	@echo "=== Assembling SD card structure ==="
	./scripts/package_switch.sh sdcard

help:
	@echo "PipensX Video Downloader - Switch Packaging"
	@echo ""
	@echo "Targets:"
	@echo "  switch   - Compile for Switch (requires devkitPRO)"
	@echo "  sdcard   - Create SD card folder structure"
	@echo "  help     - Show this help"
	@echo ""
	@echo "Linux testing:"
	@echo "  make -f Makefile.Linux"
	@echo "  ./test_catalog_parser_bin   (run catalog tests)"
	@echo ""
	@echo "SD card layout (sdcard/switch/pipensx-video-downloader/):"
	@echo "  pipensx-video-downloader.nro"
	@echo "  resources/catalog/movies.json"
	@echo "  README.txt"
