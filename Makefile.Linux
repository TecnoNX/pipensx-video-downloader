# Makefile.Linux - Compilar pipensx-video-downloader para Linux (testing)
#
# Este Makefile compila el core del torrent engine + catalog parser
# para testing en Linux. Exclui ui_catalog.c que necesita headers de Switch.
#
# Uso:
#   make linux          # Compilar para Linux
#   make linux-clean    # Limpiar build
#   make help           # Mostrar ayuda

APP_NAME := pipensx-video-downloader
CC := gcc
CFLAGS := -O2 -Wall -Wextra -std=c11 -D_POSIX_C_SOURCE=200809L
LDFLAGS := -lpthread
INCLUDES := -I. -Isrc/core -Isrc/app

SRC_DIR := src
CORE_DIR := $(SRC_DIR)/core
APP_DIR := $(SRC_DIR)/app

# Core sources (all .c files in core/)
CORE_SOURCES := $(wildcard $(CORE_DIR)/*.c)

# App sources - exclude ui_catalog.c (Switch-only)
APP_SOURCES := $(filter-out $(APP_DIR)/ui_catalog.c, $(wildcard $(APP_DIR)/*.c))

ALL_SOURCES := $(CORE_SOURCES) $(APP_SOURCES)

# Object files
CORE_OBJECTS := $(CORE_SOURCES:$(CORE_DIR)/%.c=$(CORE_DIR)/%.o)
APP_OBJECTS := $(APP_SOURCES:$(APP_DIR)/%.c=$(APP_DIR)/%.o)
ALL_OBJECTS := $(CORE_OBJECTS) $(APP_OBJECTS)

TARGET := $(APP_NAME)

.PHONY: all linux linux-clean help

all: linux

linux: $(TARGET)

$(TARGET): $(ALL_OBJECTS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

$(CORE_DIR)/%.o: $(CORE_DIR)/%.c
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

$(APP_DIR)/%.o: $(APP_DIR)/%.c
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

clean: linux-clean

linux-clean:
	rm -f $(ALL_OBJECTS) $(TARGET)

help:
	@echo "PipensX Video Downloader - Linux Build"
	@echo ""
	@echo "Targets:"
	@echo "  linux          - Compile for Linux (core + catalog parser)"
	@echo "  linux-clean    - Clean build artifacts"
	@echo "  help           - Show this help"
	@echo ""
	@echo "Note: UI (ui_catalog.c) is Switch-only."
	@echo "For catalog/parser tests, use: gcc tests/test_catalog_parser.c src/app/movie_catalog.c -o test_bin"
